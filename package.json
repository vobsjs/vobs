{
  "name": "vobs-framework",
  "version": "1.8.6",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Signals First · Zero Re-renders · Ultra Lightweight",
  "scripts": {
    "bench": "node scripts/bench/reactivity.mjs && node scripts/bench/e2e.mjs && node scripts/bench/jsdom-control.mjs",
    "bench:e2e": "node scripts/bench/e2e.mjs",
    "bench:reactivity": "node scripts/bench/reactivity.mjs",
    "build": "pnpm run build:packages && pnpm run typecheck && pnpm --filter @vobs-playground/basic build",
    "build:dsh": "node scripts/build-dsh-plugins.mjs",
    "build:dsh-console": "node scripts/build-dsh-plugins.mjs dsh-console",
    "build:dsh-devkit": "node scripts/build-dsh-plugins.mjs dsh-devkit",
    "build:dsh-plugin": "node scripts/build-dsh-plugins.mjs dsh-plugin",
    "build:packages": "node scripts/build-packages.mjs",
    "check:imports": "node scripts/check-imports.mjs",
    "check:packages": "node scripts/check-packages.mjs",
    "check:release": "node scripts/check-release.mjs",
    "release:version": "node scripts/set-version.mjs",
    "check:source": "node packages/cli/bin/vobs.js check",
    "dev": "pnpm --filter @vobs-playground/basic dev",
    "pack:packages": "pnpm --filter @vobs/reactivity --filter @vobs/runtime --filter @vobs/dom --filter @vobs/vobs --filter @vobs/compiler --filter @vobs/icon-core --filter @vobs/notification --filter @vobs/auth --filter @vobs/i18n --filter @vobs/layout --filter @vobs/resource --filter @vobs/theme --filter @vobs/ui --filter @vobs/kit --filter @vobs/router --filter @vobs/forms --filter @vobs/table --filter @vobs/captcha --filter @vobs/devtools --filter @vobs/devtools-ui --filter @vobs/dict --filter @vobs/http --filter @vobs/jwt-auth --filter @vobs/logger --filter @vobs/preferences --filter @vobs/queue --filter @vobs/ssr --filter @vobs/storage --filter @vobs/sync --filter @vobs/tailwind --filter @vobs/test-utils --filter @vobs/transition --filter @vobs/upload --filter @vobs/vite-plugin --filter @vobs/cli --filter @vobs/payment --filter @vobs/dsh pack --pack-destination .artifacts",
    "publish:local": "pnpm --filter @vobs/reactivity --filter @vobs/runtime --filter @vobs/dom --filter @vobs/vobs --filter @vobs/compiler --filter @vobs/icon-core --filter @vobs/notification --filter @vobs/auth --filter @vobs/i18n --filter @vobs/layout --filter @vobs/resource --filter @vobs/theme --filter @vobs/ui --filter @vobs/kit --filter @vobs/router --filter @vobs/forms --filter @vobs/table --filter @vobs/captcha --filter @vobs/devtools --filter @vobs/devtools-ui --filter @vobs/dict --filter @vobs/http --filter @vobs/jwt-auth --filter @vobs/logger --filter @vobs/preferences --filter @vobs/queue --filter @vobs/ssr --filter @vobs/storage --filter @vobs/sync --filter @vobs/tailwind --filter @vobs/test-utils --filter @vobs/transition --filter @vobs/upload --filter @vobs/vite-plugin --filter @vobs/cli --filter @vobs/payment --filter @vobs/dsh publish --no-git-checks --access public",
    "publish:packages": "pnpm --filter @vobs/reactivity --filter @vobs/runtime --filter @vobs/dom --filter @vobs/vobs --filter @vobs/compiler --filter @vobs/icon-core --filter @vobs/notification --filter @vobs/auth --filter @vobs/i18n --filter @vobs/layout --filter @vobs/resource --filter @vobs/theme --filter @vobs/ui --filter @vobs/kit --filter @vobs/router --filter @vobs/forms --filter @vobs/table --filter @vobs/captcha --filter @vobs/devtools --filter @vobs/devtools-ui --filter @vobs/dict --filter @vobs/http --filter @vobs/jwt-auth --filter @vobs/logger --filter @vobs/preferences --filter @vobs/queue --filter @vobs/ssr --filter @vobs/storage --filter @vobs/sync --filter @vobs/tailwind --filter @vobs/test-utils --filter @vobs/transition --filter @vobs/upload --filter @vobs/vite-plugin --filter @vobs/cli --filter @vobs/payment --filter @vobs/dsh publish --no-git-checks --provenance --access public",
    "test": "vitest --environment jsdom",
    "test:run": "vitest --environment jsdom --run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "verify:packages": "pnpm run build:packages && pnpm run check:packages && node scripts/verify-packages.mjs",
    "check:runtime": "node scripts/check-runtime.mjs --ignore /devtools",
    "check:runtime:interact": "node scripts/check-runtime.mjs --interact --ignore /devtools"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "jsdom": "^30.0.1",
    "tsup": "8.5.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^5.0.0"
  }
}
