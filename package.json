{
  "name": "vobs-framework",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Signals First · Zero Re-renders · Ultra Lightweight",
  "scripts": {
    "build": "pnpm run build:packages && pnpm run typecheck && pnpm --filter @vobs-playground/basic build",
    "build:packages": "node scripts/build-packages.mjs",
    "check:packages": "node scripts/check-packages.mjs",
    "check:release": "node scripts/check-release.mjs",
    "verify:packages": "pnpm run build:packages && pnpm run check:packages && node scripts/verify-packages.mjs",
    "pack:packages": "pnpm --filter @vobs/reactivity --filter @vobs/runtime --filter @vobs/dom --filter @vobs/vobs --filter @vobs/compiler --filter @vobs/icon-core --filter @vobs/notification --filter @vobs/auth --filter @vobs/i18n --filter @vobs/layout --filter @vobs/resource --filter @vobs/theme --filter @vobs/ui --filter @vobs/kit --filter @vobs/router --filter @vobs/forms --filter @vobs/table --filter @vobs/captcha --filter @vobs/devtools --filter @vobs/devtools-ui --filter @vobs/dict --filter @vobs/http --filter @vobs/jwt-auth --filter @vobs/logger --filter @vobs/preferences --filter @vobs/queue --filter @vobs/ssr --filter @vobs/storage --filter @vobs/sync --filter @vobs/tailwind --filter @vobs/test-utils --filter @vobs/transition --filter @vobs/upload --filter @vobs/vite-plugin --filter @vobs/cli --filter @vobs/payment pack --pack-destination .artifacts",
    "publish:packages": "pnpm --filter @vobs/reactivity --filter @vobs/runtime --filter @vobs/dom --filter @vobs/vobs --filter @vobs/compiler --filter @vobs/icon-core --filter @vobs/notification --filter @vobs/auth --filter @vobs/i18n --filter @vobs/layout --filter @vobs/resource --filter @vobs/theme --filter @vobs/ui --filter @vobs/kit --filter @vobs/router --filter @vobs/forms --filter @vobs/table --filter @vobs/captcha --filter @vobs/devtools --filter @vobs/devtools-ui --filter @vobs/dict --filter @vobs/http --filter @vobs/jwt-auth --filter @vobs/logger --filter @vobs/preferences --filter @vobs/queue --filter @vobs/ssr --filter @vobs/storage --filter @vobs/sync --filter @vobs/tailwind --filter @vobs/test-utils --filter @vobs/transition --filter @vobs/upload --filter @vobs/vite-plugin --filter @vobs/cli --filter @vobs/payment publish --no-git-checks --provenance --access public",
    "sync:uistyle": "node scripts/sync-uistyle.mjs",
    "test": "vitest --environment jsdom",
    "test:run": "vitest --environment jsdom --run",
    "bench": "vitest bench --run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dev": "pnpm --filter @vobs-playground/basic dev"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "jsdom": "^30.0.1",
    "tsup": "8.5.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  }
}
