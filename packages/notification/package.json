{
  "license": "MIT",
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "name": "@vobs/notification",
  "repository": { "type": "git", "url": "git+https://github.com/vobsjs/vobs.git" },
  "version": "1.2.0",
  "publishConfig": { "access": "public" },
  "description": "Reactive notification state and lifecycle for Vobs applications.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "scripts": {
    "test": "vitest --environment jsdom"
  },
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js", "require": "./dist/index.cjs", "default": "./dist/index.js" },
    "./source": { "types": "./src/index.ts", "default": "./src/index.ts" },
    "./source/*": "./src/*"
  },
  "dependencies": {
    "@vobs/reactivity": "workspace:*",
    "@vobs/vobs": "workspace:*"
  }
}
