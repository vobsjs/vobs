{
  "name": "dsh-plugin-vobs-devkit",
  "version": "1.7.8",
  "description": "Vobs DevKit: browse vobs APIs, examples, and guardrail rules inside DSH",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vobsjs/vobs.git",
    "directory": "packages/dsh-devkit"
  },
  "homepage": "https://github.com/vobsjs/vobs/tree/main/packages/dsh-devkit",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "build": "node ../../scripts/build-dsh-plugins.mjs dsh-devkit",
    "verify": "node scripts/verify-devkit.mjs"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  }
}
