{
    "license": "MIT",
    "files": [
        "dist",
        "src",
        "README.md",
        "LICENSE"
    ],
    "name": "@vobs/dom",
  "version": "1.2.0",
    "publishConfig": { "access": "public" },
    "type": "module",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js", "require": "./dist/index.cjs", "default": "./dist/index.js" },
        "./source": { "types": "./src/index.ts", "default": "./src/index.ts" },
        "./source/*": "./src/*"
    },
    "dependencies": {
        "@vobs/runtime": "workspace:*"
    },
    "devDependencies": {
        "@vobs/reactivity": "workspace:*"
    }
}
