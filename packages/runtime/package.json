{
  "license": "MIT",
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "name": "@vobs/runtime",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vobsjs/vobs.git"
  },
  "version": "1.8.3",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./error": {
      "types": "./dist/error.d.ts",
      "import": "./dist/error.js",
      "require": "./dist/error.cjs",
      "default": "./dist/error.js"
    },
    "./dom-props": {
      "types": "./dist/dom-props.d.ts",
      "import": "./dist/dom-props.js",
      "require": "./dist/dom-props.cjs",
      "default": "./dist/dom-props.js"
    },
    "./dom-events": {
      "types": "./dist/dom-events.d.ts",
      "import": "./dist/dom-events.js",
      "require": "./dist/dom-events.cjs",
      "default": "./dist/dom-events.js"
    },
    "./svg": {
      "types": "./dist/svg.d.ts",
      "import": "./dist/svg.js",
      "require": "./dist/svg.cjs",
      "default": "./dist/svg.js"
    },
    "./source": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./source/*": "./src/*"
  },
  "dependencies": {
    "@vobs/reactivity": "workspace:*"
  }
}
