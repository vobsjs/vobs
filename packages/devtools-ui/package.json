{
  "license": "MIT",
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "name": "@vobs/devtools-ui",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vobsjs/vobs.git"
  },
  "version": "1.3.1",
  "publishConfig": {
    "access": "public"
  },
  "description": "Optional reusable DevTools panel UI for Vobs.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "./dist/styles/*.css",
    "./src/styles/*.css"
  ],
  "scripts": {
    "test": "vitest --environment jsdom"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./panel": {
      "types": "./dist/panel.d.ts",
      "import": "./dist/panel.js",
      "require": "./dist/panel.cjs",
      "default": "./dist/panel.js"
    },
    "./widget": {
      "types": "./dist/widget.d.ts",
      "import": "./dist/widget.js",
      "require": "./dist/widget.cjs",
      "default": "./dist/widget.js"
    },
    "./styles.css": "./dist/styles/styles.css",
    "./source": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./source/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@vobs/devtools": "workspace:*",
    "@vobs/http": "workspace:*",
    "@vobs/router": "workspace:*",
    "@vobs/ui": "workspace:*",
    "@vobs/vobs": "workspace:*"
  }
}
