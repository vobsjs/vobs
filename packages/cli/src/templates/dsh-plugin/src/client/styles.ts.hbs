/**
 * 面板样式。由 @vobs/dsh 注入 shadow root：DSH 的全局 CSS 进不来，这里也漏不出去。
 *
 * 配色优先读 DSH 的 design token（会继承进 shadow root），读不到就按
 * `data-scheme` 回退 —— 所以脱离 DSH 预览时同样好看。
 */
export const PANEL_CSS = `
:where(*, *::before, *::after) { box-sizing: border-box; }

.vobs-dsh-root {
  --p-bg: rgba(26, 27, 33, 0.94);
  --p-fg: #e9eaf0;
  --p-fg-muted: #9aa1ae;
  --p-line: rgba(255, 255, 255, 0.14);
  --p-accent: #8f80ff;
  --p-shadow: 0 18px 48px rgba(0, 0, 0, 0.46);
}
.vobs-dsh-root[data-scheme='light'] {
  --p-bg: rgba(255, 255, 255, 0.96);
  --p-fg: #1b1c22;
  --p-fg-muted: #6b7280;
  --p-line: rgba(15, 18, 32, 0.12);
  --p-accent: #5b47e0;
  --p-shadow: 0 18px 48px rgba(15, 18, 32, 0.22);
}

.panel {
  width: 300px;
  border: 1px solid var(--p-line);
  border-radius: 14px;
  background: var(--p-bg);
  box-shadow: var(--p-shadow);
  backdrop-filter: blur(14px);
  color: var(--p-fg);
  font: 13px/1.55 ui-sans-serif, system-ui, -apple-system, 'Segoe UI', 'Microsoft YaHei', sans-serif;
}

.panel__head {
  display: flex; align-items: center; gap: 8px;
  padding: 10px 12px; border-bottom: 1px solid var(--p-line);
}
.panel__brand { font-weight: 650; }
.panel__tag {
  padding: 1px 7px; border-radius: 999px; font-size: 11px; font-weight: 600;
  background: color-mix(in srgb, var(--p-accent) 18%, transparent);
  color: var(--p-accent);
}
.panel__body { padding: 12px; display: grid; gap: 12px; }
.panel__hint { margin: 0; color: var(--p-fg-muted); font-size: 12px; }
.panel__hint code {
  font-family: ui-monospace, Menlo, Consolas, monospace; font-size: 11.5px;
  padding: 1px 5px; border-radius: 5px;
  background: color-mix(in srgb, var(--p-fg) 8%, transparent);
}
.panel__row { display: flex; align-items: center; gap: 10px; }
.panel__count { font-size: 18px; font-weight: 650; font-variant-numeric: tabular-nums; min-width: 32px; text-align: center; }
.panel__btn {
  padding: 5px 12px; border: 1px solid var(--p-line); border-radius: 8px;
  background: transparent; color: inherit; font: inherit; font-size: 12px; cursor: pointer;
}
.panel__btn:hover { background: color-mix(in srgb, var(--p-fg) 8%, transparent); }
.panel__btn--primary {
  border-color: transparent; background: var(--p-accent); color: #fff; font-weight: 600;
}
`
