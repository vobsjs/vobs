/**
 * Client half entry. Built by dshBundle() into lib/client.js:
 *
 *   window.__ModuleLoader__.load({ id: '{{packageName}}', factory: function (require) { … } })
 *
 * The adapter layer (@vobs/dsh) handles React bindings, the shadow root host, slot
 * registration, color-scheme following, and cleanup; all that remains here is
 * "which slot to mount into" and "what to render".
 */
import { defineDshOverlay } from '@vobs/dsh'
import { Panel } from './panel'
import { PANEL_CSS } from './styles'

/**
 * shell.overlay is a list slot declared by @deepseek-ai/dsh-client-ui-layout (scope: root);
 * DSH's own quota notices and plugin-manager toasts mount here.
 */
export default defineDshOverlay(
  {
    id: '{{rowId}}',
    order: 120,
    styles: PANEL_CSS
  },
  () => <Panel />
)
