import { state } from '@vobs/vobs'

/**
 * Panel body. The whole function **executes exactly once** — each `{…}` below is compiled
 * into its own DOM binding effect; updates only touch the one text node that changed, and
 * no component ever re-renders.
 */
export function Panel() {
  const count = state(0)

  return (
    <div class="panel">
      <header class="panel__head">
        <span class="panel__brand">{{displayName}}</span>
        <span class="panel__tag">rendered by vobs</span>
      </header>

      <div class="panel__body">
        <p class="panel__hint">
          Edit <code>src/client/panel.tsx</code> and watch the UI change;
          <code>vobs dsh dev</code> previews it without installing into DSH.
        </p>

        <div class="panel__row">
          <button
            class="panel__btn"
            onClick={() => {
              count.value -= 1
            }}
          >
            −1
          </button>
          <span class="panel__count">{count.value}</span>
          <button
            class="panel__btn panel__btn--primary"
            onClick={() => {
              count.value += 1
            }}
          >
            +1
          </button>
        </div>
      </div>
    </div>
  )
}
