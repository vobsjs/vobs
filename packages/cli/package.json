{
  "name": "@vobs/cli",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vobsjs/vobs.git"
  },
  "version": "1.3.7",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "license": "MIT",
  "description": "Vobs framework CLI - project scaffolding, code generation, and dev/build tools",
  "bin": {
    "vobs": "./bin/vobs.js"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./source": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./source/*": "./src/*"
  },
  "dependencies": {
    "@clack/prompts": "^0.7.0",
    "cac": "^6.7.14",
    "handlebars": "^4.7.8",
    "picocolors": "^1.0.0",
    "tsx": "^4.19.0"
  },
  "peerDependencies": {
    "vite": "^5.0.0 || ^6.0.0 || ^7.0.0"
  },
  "files": [
    "bin",
    "dist",
    "src"
  ]
}
