{
  "license": "MIT",
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "name": "@vobs/compiler",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vobsjs/vobs.git"
  },
  "version": "1.3.6",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./compile": {
      "types": "./dist/compile.d.ts",
      "import": "./dist/compile.js",
      "require": "./dist/compile.cjs",
      "default": "./dist/compile.js"
    },
    "./source": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./source/*": "./src/*"
  },
  "dependencies": {
    "typescript": "^5.9.3",
    "@vobs/runtime": "workspace:*"
  }
}
