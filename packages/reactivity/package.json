{
  "license": "MIT",
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "name": "@vobs/reactivity",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vobsjs/vobs.git"
  },
  "version": "1.4.0",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./state": {
      "types": "./dist/signal.d.ts",
      "import": "./dist/signal.js",
      "require": "./dist/signal.cjs",
      "default": "./dist/signal.js"
    },
    "./memo": {
      "types": "./dist/memo.d.ts",
      "import": "./dist/memo.js",
      "require": "./dist/memo.cjs",
      "default": "./dist/memo.js"
    },
    "./effect": {
      "types": "./dist/effect.d.ts",
      "import": "./dist/effect.js",
      "require": "./dist/effect.cjs",
      "default": "./dist/effect.js"
    },
    "./owner": {
      "types": "./dist/owner.d.ts",
      "import": "./dist/owner.js",
      "require": "./dist/owner.cjs",
      "default": "./dist/owner.js"
    },
    "./id": {
      "types": "./dist/id.d.ts",
      "import": "./dist/id.js",
      "require": "./dist/id.cjs",
      "default": "./dist/id.js"
    },
    "./scheduler": {
      "types": "./dist/scheduler.d.ts",
      "import": "./dist/scheduler.js",
      "require": "./dist/scheduler.cjs",
      "default": "./dist/scheduler.js"
    },
    "./source": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./source/*": "./src/*"
  },
  "scripts": {
    "test": "vitest"
  }
}
