{
  "license": "MIT",
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "name": "@vobs/kit",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vobsjs/vobs.git"
  },
  "version": "1.9.2",
  "publishConfig": {
    "access": "public"
  },
  "description": "Optional official Kit composition package for Vobs.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "test": "vitest --environment jsdom"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./page": {
      "types": "./dist/page.d.ts",
      "import": "./dist/page.js",
      "require": "./dist/page.cjs",
      "default": "./dist/page.js"
    },
    "./filter-bar": {
      "types": "./dist/filter-bar.d.ts",
      "import": "./dist/filter-bar.js",
      "require": "./dist/filter-bar.cjs",
      "default": "./dist/filter-bar.js"
    },
    "./page-actions": {
      "types": "./dist/page-actions.d.ts",
      "import": "./dist/page-actions.js",
      "require": "./dist/page-actions.cjs",
      "default": "./dist/page-actions.js"
    },
    "./toolbar-bar": {
      "types": "./dist/toolbar-bar.d.ts",
      "import": "./dist/toolbar-bar.js",
      "require": "./dist/toolbar-bar.cjs",
      "default": "./dist/toolbar-bar.js"
    },
    "./table-panel": {
      "types": "./dist/table-panel.d.ts",
      "import": "./dist/table-panel.js",
      "require": "./dist/table-panel.cjs",
      "default": "./dist/table-panel.js"
    },
    "./stat-row": {
      "types": "./dist/stat-row.d.ts",
      "import": "./dist/stat-row.js",
      "require": "./dist/stat-row.cjs",
      "default": "./dist/stat-row.js"
    },
    "./layout": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles/styles.css",
    "./kit.css": "./dist/styles/kit.css",
    "./source": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./source/*": "./src/*",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "./dist/styles/*.css",
    "./src/styles/*.css"
  ],
  "dependencies": {
    "@vobs/auth": "workspace:*",
    "@vobs/i18n": "workspace:*",
    "@vobs/layout": "workspace:*",
    "@vobs/reactivity": "workspace:*",
    "@vobs/resource": "workspace:*",
    "@vobs/router": "workspace:*",
    "@vobs/table": "workspace:*",
    "@vobs/theme": "workspace:*",
    "@vobs/vobs": "workspace:*",
    "@vobs/ui": "workspace:*"
  }
}
